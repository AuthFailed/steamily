TELEGRAM_BOT_TOKEN=
# Run python -m bot.setup to generate this once. Back up .env securely.
# Losing or replacing SECRET_KEY makes stored Steam logins unreadable.
SECRET_KEY=
# Use a URL-safe password (letters, digits, dots, hyphens, underscores, tildes).
POSTGRES_PASSWORD=
POLL_INTERVAL_SECONDS=600
# Public plain text shown by /about: operator name and contact, and hosting provider/country.
# Set these before inviting people to a hosted instance. Empty values are shown as unknown.
INSTANCE_OPERATOR=
INSTANCE_HOSTING=
# Public plain text: the location Steam offers during login, i.e. where this bot's server is, e.g. "Vienna, Wien, AT".
# Use the actual observed login location; empty is shown as unknown.
LOGIN_LOCATION=
# Optional: pin a published release image, for example 1.1.0. main tracks development.
STEAMILY_VERSION=main
